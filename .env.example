# これをコピーして .env を作る。.env は .gitignore 済み（絶対にコミットしない）。
#
#   cp .env.example .env

# --- WordPress（SWELL / エックスサーバー）-----------------------------------
# サイトのトップ URL。末尾のスラッシュは不要
WP_URL=https://example.com
# WordPress のログインユーザー名
WP_USER=your-username
# 管理画面 → ユーザー → プロフィール → 「アプリケーションパスワード」で発行した値。
# 半角スペース込みでそのまま貼る（例: abcd EFGH ijkl MNOP qrst UVWX）
WP_APP_PASSWORD=xxxx xxxx xxxx xxxx xxxx xxxx

# --- X ----------------------------------------------------------------------
# X Developer Portal → プロジェクト/アプリ → Keys and tokens
# アプリの権限を「Read and write」にしてから Access Token を発行すること。
# 権限を後から変えた場合は Access Token を再発行しないと 401 になる。
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=
